      "script": "export class MaxConfigDO {\n  constructor(state) { this.state = state; }\n  async fetch(request) {\n    const count = (await this.state.storage.get('count') || 0) + 1;\n    await this.state.storage.put('count', count);\n    return new Response(JSON.stringify({ count }), { headers: { 'Content-Type': 'application/json' } });\n  }\n}\n\nexport default {\n  async fetch(request, env) {\n    const url = new URL(request.url);\n    if (url.pathname === '/do') {\n      const id = env.MAXCONFIG_DO.idFromName('default');\n      const stub = env.MAXCONFIG_DO.get(id);\n      return stub.fetch(request);\n    }\n    if (url.pathname === '/kv') {\n      const val = await env.MAXCONFIG_KV.get('feature-flag-1');\n      return new Response(JSON.stringify({ kv: val }), { headers: { 'Content-Type': 'application/json' } });\n    }\n    if (url.pathname === '/queue') {\n      await env.MAXCONFIG_QUEUE.send({ ts: Date.now() });\n      return new Response(JSON.stringify({ queued: true }), { headers: { 'Content-Type': 'application/json' } });\n    }\n    if (url.pathname === '/svc') {\n      return env.MAXCONFIG_SVC.fetch(request);\n    }\n    if (url.pathname === '/r2') {\n      const obj = await env.MAXCONFIG_R2.get('config.json');\n      return new Response(obj ? await obj.text() : 'not-found', { headers: { 'Content-Type': 'application/json' } });\n    }\n    if (url.pathname === '/d1') {\n      const r = await env.MAXCONFIG_D1.prepare('SELECT * FROM feature_flags').all();\n      return Response.json(r);\n    }\n    if (url.pathname === '/secret') {\n      return new Response(env.MAXCONFIG_SECRET || 'unset');\n    }\n    return new Response(JSON.stringify({ worker: 'maxconfig-zone-worker', path: url.pathname, ts: Date.now() }), { headers: { 'Content-Type': 'application/json' } });\n  }\n};",
      "bindings": [
        {
          "type": "durable_object_namespace",
          "name": "MAXCONFIG_DO",
          "class_name": "MaxConfigDO"
        },
        {
          "type": "kv_namespace",
          "name": "MAXCONFIG_KV",
          "namespace_id": "__MAXCONFIG_KV_STORE_ID__"
        },
        {
          "type": "queue",
          "name": "MAXCONFIG_QUEUE",
          "queue_name": "maxconfig-queue"
        },
        {
          "type": "r2_bucket",
          "name": "MAXCONFIG_R2",
          "bucket_name": "maxconfig-r2-bucket"
        },
        {
          "type": "d1",
          "name": "MAXCONFIG_D1",
          "database_id": "__MAXCONFIG_D1_DB_ID__"
        },
        {
          "type": "service",
          "name": "MAXCONFIG_SVC",
          "service": "maxconfig-svc-worker",
          "environment": "production"
        },
        {
          "type": "secret_text",
          "name": "MAXCONFIG_SECRET"
        }
      ]
    }
  ],
