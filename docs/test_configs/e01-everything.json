        "action_parameters": {
          "bic": true,
          "rocket_loader": true
        },
        "description": "Optimized config - MaxConfig"
      }
    ],
    "http_request_transform": [
      {
        "expression": "(http.request.uri.path eq \"/maxconfig-old-path\")",
        "action": "rewrite",
        "action_parameters": {
          "uri": {
            "path": {
