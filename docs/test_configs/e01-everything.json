  "firewall_rules": [
    {
      "filter": {
        "expression": "(http.request.uri.path contains \"/admin\")"
      },
      "action": "block",
      "description": "Block admin access - MaxConfig"
    },
    {
      "filter": {
        "expression": "(cf.threat_score gt 14)"
      },
      "action": "js_challenge",
      "description": "JS challenge threats - MaxConfig"
    },
    {
      "filter": {
        "expression": "(http.user_agent contains \"BadBot\")"
      },
      "action": "challenge",
      "description": "Challenge bad UA - MaxConfig"
    },
    {
      "filter": {
        "expression": "(not ip.geoip.country in {\"US\" \"CA\" \"GB\" \"DE\" \"JP\" \"AU\"})"
      },
      "action": "challenge",
      "description": "Geo-challenge - MaxConfig"
    },
    {
      "filter": {
        "expression": "(http.request.method ne \"GET\" and http.request.method ne \"POST\" and http.request.method ne \"PUT\" and http.request.method ne \"DELETE\" and http.request.method ne \"OPTIONS\")"
      },
      "action": "block",
      "description": "Block exotic methods - MaxConfig"
    }
  ],
