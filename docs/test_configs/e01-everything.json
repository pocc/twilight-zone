            }
          }
        },
        "description": "URL rewrite - MaxConfig"
      }
    ],
    "http_request_late_transform": [
      {
        "expression": "starts_with(http.request.uri.path, \"/maxconfig/\")",
        "action": "rewrite",
        "action_parameters": {
          "headers": {
            "X-MaxConfig-Request": {
              "operation": "set",
              "value": "enabled"
            }
          }
        },
        "description": "Add request header - MaxConfig"
      }
    ],
    "http_response_headers_transform": [
      {
        "expression": "starts_with(http.request.uri.path, \"/maxconfig/\")",
        "action": "rewrite",
        "action_parameters": {
          "headers": {
            "X-MaxConfig-Response": {
              "operation": "set",
              "value": "enabled"
            }
          }
        },
        "description": "Add response header - MaxConfig"
      }
    ],
    "http_request_dynamic_redirect": [
      {
        "expression": "(http.request.uri.path eq \"/maxconfig-redirect-me\")",
        "action": "redirect",
        "action_parameters": {
          "from_value": {
            "status_code": 302,
            "target_url": {
              "value": "/maxconfig-redirected"
            },
            "preserve_query_string": true
          }
        },
        "description": "Test redirect - MaxConfig"
      }
    ],
    "http_response_compression": [
      {
        "expression": "starts_with(http.request.uri.path, \"/maxconfig-compress/\")",
        "action": "compress_response",
        "action_parameters": {
          "algorithms": [
            {
              "name": "gzip"
            },
            {
              "name": "brotli"
            }
          ]
        },
        "description": "Enable compression - MaxConfig"
      }
    ],
    "http_ratelimit": [
      {
        "expression": "starts_with(http.request.uri.path, \"/maxconfig-api/\")",
        "action": "block",
        "ratelimit": {
          "characteristics": [
