  "workers": [
    {
      "name": "storage-rt-reader",
      "format": "modules",
      "main_module": "worker.js",
      "script": "// Worker that reads from KV, R2, D1, Queue \u2014 exercises ID remap for KV/D1 and name lookup for R2/Queue.\n// All four KV namespaces are seeded on source by the harness (config, sessions, features, AUTOCREATED)\n// so worker upload succeeds and the migration covers the storage-binding round-trip end-to-end.\nexport default {\n  async fetch(request, env) {\n    const url = new URL(request.url);\n    if (url.pathname === '/kv-config') {\n      return new Response(await env.CONFIG.get('config:version') || '');\n    }\n    if (url.pathname === '/kv-auto') {\n      // This binding's namespace must be auto-created since it's not in kv_namespaces.\n      const v = await env.AUTOCREATED.get('initialized');\n      return new Response(v ?? 'auto-empty');\n    }\n    if (url.pathname === '/r2') {\n      const o = await env.ASSETS.get('static/index.html');\n      return new Response(o ? await o.text() : 'r2-missing');\n    }\n    if (url.pathname === '/d1') {\n      const r = await env.DB.prepare('SELECT * FROM users LIMIT 5').all();\n      return Response.json(r.results);\n    }\n    if (url.pathname === '/queue') {\n      await env.EVENTS.send({ ts: Date.now() });\n      return new Response('queued');\n    }\n    return Response.json({ help: ['/kv-config', '/kv-auto', '/r2', '/d1', '/queue'] });\n  }\n};",
      "bindings": [
        {
          "type": "kv_namespace",
          "name": "CONFIG",
          "namespace_id": "__STORAGE_RT_CONFIG_ID__"
        },
        {
          "type": "kv_namespace",
          "name": "SESSIONS",
          "namespace_id": "__STORAGE_RT_SESSIONS_ID__"
        },
        {
          "type": "kv_namespace",
          "name": "FEATURES",
          "namespace_id": "__STORAGE_RT_FEATURES_ID__"
        },
        {
          "type": "kv_namespace",
          "name": "AUTOCREATED",
          "namespace_id": "__STORAGE_RT_AUTOCREATED_ID__"
        },
        {
          "type": "r2_bucket",
          "name": "ASSETS",
          "bucket_name": "storage-rt-assets"
        },
        {
          "type": "d1",
          "name": "DB",
          "database_id": "__STORAGE_RT_APP_DB_ID__"
        },
        {
          "type": "queue",
          "name": "EVENTS",
          "queue_name": "storage-rt-events"
        }
      ]
    }
  ],
  "worker_routes": [
    {
      "pattern": "test.example.com/rt/*",
      "script": "storage-rt-reader"
    }
